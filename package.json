{
  "name": "teen-patti-app",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",

    "test": "bash scripts/test.sh --unit",
    "test:unit": "npx jest --no-coverage --verbose",
    "test:watch": "npx jest --watch",
    "test:coverage": "npx jest --coverage",
    "test:file": "npx jest --no-coverage --verbose --testPathPattern",
    "test:name": "npx jest --no-coverage --verbose --testNamePattern",

    "test:e2e": "bash scripts/test-e2e.sh",
    "test:e2e:ios": "bash scripts/test-e2e.sh --ios",
    "test:e2e:android": "bash scripts/test-e2e.sh --android",
    "test:e2e:both": "bash scripts/test-e2e.sh --both",
    "test:e2e:flow": "bash scripts/test-e2e.sh --ios --flow",

    "test:all": "bash scripts/test.sh --all"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@sentry/react-native": "~6.10.0",
    "expo": "~52.0.46",
    "expo-av": "~15.0.2",
    "expo-build-properties": "~0.13.3",
    "expo-clipboard": "~7.0.1",
    "expo-firebase-recaptcha": "^2.3.1",
    "expo-haptics": "~14.0.1",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "expo-linear-gradient": "~14.0.2",
    "expo-status-bar": "~2.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^15.18.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-modal": "^13.0.1",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-webrtc": "^118.0.0",
    "react-native-webview": "13.12.5",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "typescript": "^5.3.3"
  },
  "private": true
}
