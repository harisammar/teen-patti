rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helper functions
    // -----------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isRoomMember(roomId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid));
    }

    function isRoomAdmin(roomId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/rooms/$(roomId)).data.adminId == request.auth.uid;
    }

    // -----------------------------------------------------------------------
    // Users collection
    // -----------------------------------------------------------------------

    match /users/{uid} {
      // Users can read any profile (for leaderboards, lobby listings)
      allow read: if isAuthenticated();

      // Users can only write their own profile
      allow write: if isOwner(uid);
    }

    // -----------------------------------------------------------------------
    // Rooms collection
    // -----------------------------------------------------------------------

    match /rooms/{roomId} {
      // Any authenticated user can list/read public rooms
      allow read: if isAuthenticated();

      // Only authenticated users can create rooms
      allow create: if isAuthenticated()
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.maxPlayers >= 2
        && request.resource.data.maxPlayers <= 8
        && request.resource.data.bootAmount >= 10
        && request.resource.data.startingPoints >= 500;

      // Room admins can update room settings; members can update player count
      allow update: if isRoomAdmin(roomId) || isRoomMember(roomId);

      // Only the admin can delete a room
      allow delete: if isRoomAdmin(roomId);

      // -----------------------------------------------------------------------
      // Players subcollection (room membership)
      // -----------------------------------------------------------------------

      match /players/{playerId} {
        // Room members can read the player list
        allow read: if isAuthenticated();

        // Users can add themselves, or admin can add/remove anyone
        allow create: if isOwner(playerId) || isRoomAdmin(roomId);
        allow delete: if isOwner(playerId) || isRoomAdmin(roomId);
        allow update: if isOwner(playerId) || isRoomAdmin(roomId);
      }

      // -----------------------------------------------------------------------
      // Games subcollection
      // -----------------------------------------------------------------------

      match /games/{gameId} {
        // Room members can read game state
        allow read: if isAuthenticated();

        // Only admin can create a game
        allow create: if isRoomAdmin(roomId);

        // Room members can update (betting, card peeking, etc.)
        allow update: if isRoomMember(roomId);

        // Only admin can delete a game
        allow delete: if isRoomAdmin(roomId);
      }

      // -----------------------------------------------------------------------
      // Messages subcollection (chat)
      // -----------------------------------------------------------------------

      match /messages/{messageId} {
        // Room members can read and write messages
        allow read: if isAuthenticated();
        allow create: if isRoomMember(roomId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text.size() <= 500;

        // Messages are immutable once created
        allow update, delete: if false;
      }
    }
  }
}
